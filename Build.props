<Project>
  <!--
    This file is auto-imported by NuGet when this package is referenced.
    It wires up the CompilerVisibleProperty declarations that allow the source generator
    to read MSBuild properties from the Roslyn analyzer pipeline — no manual setup needed.

    You still need to set the property VALUES in your Directory.Build.props:

      <GenerateAutoVersionedAssemblyInfo>true</GenerateAutoVersionedAssemblyInfo>
      <AssemblyCompany>YourCompany</AssemblyCompany>
      <AssemblyProduct>YourProduct</AssemblyProduct>
      <PublicVersion Condition="'$(PublicVersion)' == ''">$(YOUR_CI_VERSION_VAR)</PublicVersion>
      <CommitSha Condition="'$(CommitSha)' == ''">$(GITHUB_SHA)</CommitSha>
      <IsContinuousIntegration>$(GITHUB_ACTIONS)</IsContinuousIntegration>
  -->
  <!--
    Capture the build timestamp once during MSBuild property evaluation — before any
    compilation target runs. Because all projects in a solution evaluate properties at
    roughly the same time, this ensures a consistent version number across every project
    in a multi-project build, whether driven by the IDE or the CLI.

    For an exact guarantee on CI, override this via the command line:
      dotnet build -p:BuildTimestamp=$(date +%Y%m%d%H%M%S)   # bash / GitHub Actions
      dotnet build /p:BuildTimestamp=yyyyMMddHHmmss           # cmd (format manually)
    Use LOCAL time on the machine that runs the build, as shown above — the generator parses
    this with DateTimeStyles.AssumeLocal, so a UTC timestamp (e.g. `date -u`) would be
    misinterpreted unless that machine's local zone is already UTC.

    The Condition below protects a value already set earlier in evaluation (e.g. in the
    consumer's own Directory.Build.props) from being clobbered by this default. A command-line
    override is separately protected by MSBuild's own global-property semantics — a global
    property can't be reassigned by a plain property element regardless of any Condition.
  -->
  <PropertyGroup Condition="'$(GenerateAutoVersionedAssemblyInfo)' == 'true'">
    <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">$([System.DateTime]::Now.ToString('yyyyMMddHHmmss'))</BuildTimestamp>
  </PropertyGroup>

  <!--
    Expose the calculated version to MSBUILD, not only to the compilation.

    WHY THIS EXISTS
    ===============
    The generator calculates the version inside the Roslyn pipeline, which is far too late for
    anything MSBuild needs to decide. `PackageVersion` in particular is evaluated long before
    compilation, so a consumer packing a library gets NuGet's default `1.0.0` while the assembly
    inside that package is stamped `2026.3.913.1613`. The package and its own contents disagree,
    and nothing reports it.

    `PublicVersion` does not solve this: it is a CompilerVisibleProperty read by the generator,
    so it likewise cannot be read back by MSBuild.

    So the two CalVer parts are derived here, during property evaluation, from the same
    `BuildTimestamp` the generator is handed. One captured instant, two consumers of it.

      AutoVersion         YEAR.QUARTER.MMdd.HHmm   the four-part stamp the generator emits
      AutoPackageVersion  YEAR.QUARTER.MMdd        three-part, which is what a NuGet package
                                                   wants: four-part versions are not SemVer,
                                                   and Pack.ps1 already defaults to this form

    Neither is assigned to anything. A consumer opts in explicitly, which is the whole point —
    this package should not silently take over `PackageVersion` for every project that
    references it:

      <PackageVersion>$(AutoPackageVersion)</PackageVersion>

    Both are overridable, so a release can pin the version from a tag and everything downstream
    follows.

    ⚠ REFERENCE IMPLEMENTATION IS Versioning/BuildVersion.cs — this is a second expression of
    the same algorithm, in a language that cannot share code with it, and the two must not
    drift. Specifically: `CalculateAbsoluteVersion` (year, quarter), `GetQuarter` ((Month + 2) / 3,
    integer division) and `GetBuildInfo` (`Convert.ToUInt16` over "MMdd"/"HHmm", which is what
    drops the leading zero — 09/13 becomes 913, and 00:05 becomes 5). Verified against both a
    built assembly's FileVersion (2026.3.913.1613) and this package's own published version
    (2026.3.819), plus the quarter boundaries at Mar 31 / Apr 1 and Dec 31.

    ⚠ The quarter is spelled out rather than calculated because MSBuild's Divide returns a
    DOUBLE: $([MSBuild]::Divide(11, 3)) is 3.6666666666666665, not 3.
  -->
  <PropertyGroup Condition="'$(GenerateAutoVersionedAssemblyInfo)' == 'true' And '$(BuildTimestamp.Length)' == '14'">
    <_AutoVersionYear>$(BuildTimestamp.Substring(0, 4))</_AutoVersionYear>
    <_AutoVersionMonth>$([System.Int32]::Parse($(BuildTimestamp.Substring(4, 2))))</_AutoVersionMonth>
    <_AutoVersionDay>$([System.Int32]::Parse($(BuildTimestamp.Substring(6, 2))))</_AutoVersionDay>
    <_AutoVersionHour>$([System.Int32]::Parse($(BuildTimestamp.Substring(8, 2))))</_AutoVersionHour>
    <_AutoVersionMinute>$([System.Int32]::Parse($(BuildTimestamp.Substring(10, 2))))</_AutoVersionMinute>

    <_AutoVersionQuarter Condition="$(_AutoVersionMonth) &lt;= 3">1</_AutoVersionQuarter>
    <_AutoVersionQuarter Condition="$(_AutoVersionMonth) &gt;= 4 And $(_AutoVersionMonth) &lt;= 6">2</_AutoVersionQuarter>
    <_AutoVersionQuarter Condition="$(_AutoVersionMonth) &gt;= 7 And $(_AutoVersionMonth) &lt;= 9">3</_AutoVersionQuarter>
    <_AutoVersionQuarter Condition="$(_AutoVersionMonth) &gt;= 10">4</_AutoVersionQuarter>

    <_AutoVersionMMdd>$([MSBuild]::Add($([MSBuild]::Multiply($(_AutoVersionMonth), 100)), $(_AutoVersionDay)))</_AutoVersionMMdd>
    <_AutoVersionHHmm>$([MSBuild]::Add($([MSBuild]::Multiply($(_AutoVersionHour), 100)), $(_AutoVersionMinute)))</_AutoVersionHHmm>

    <AutoPackageVersion Condition="'$(AutoPackageVersion)' == ''">$(_AutoVersionYear).$(_AutoVersionQuarter).$(_AutoVersionMMdd)</AutoPackageVersion>
    <AutoVersion Condition="'$(AutoVersion)' == ''">$(AutoPackageVersion).$(_AutoVersionHHmm)</AutoVersion>
  </PropertyGroup>

  <!--
    Suppress only the specific SDK-generated attributes that this generator also emits.
    Using granular suppressions (rather than GenerateAssemblyInfo=false) so that other
    SDK-generated attributes — such as InternalsVisibleTo from MSBuild item groups —
    are not affected.
  -->
  <PropertyGroup Condition="'$(GenerateAutoVersionedAssemblyInfo)' == 'true'">
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="GenerateAutoVersionedAssemblyInfo" />
    <CompilerVisibleProperty Include="AssemblyCompany" />
    <CompilerVisibleProperty Include="AssemblyProduct" />
    <CompilerVisibleProperty Include="CopyrightHolder" />
    <CompilerVisibleProperty Include="CommitSha" />
    <CompilerVisibleProperty Include="IsContinuousIntegration" />
    <CompilerVisibleProperty Include="PublicVersion" />
    <CompilerVisibleProperty Include="Configuration" />
    <CompilerVisibleProperty Include="BuildTimestamp" />
  </ItemGroup>

  <!--
    Prints a setup reminder in the build output until the generator is explicitly enabled.
    Fires once per project that references this package without opting in.
  -->
  <Target Name="Bennewitz_Ninja_AutoVersioning_GeneratorSetupReminder"
          AfterTargets="Build"
          Condition="'$(GenerateAutoVersionedAssemblyInfo)' != 'true'">
    <Message Importance="High"
             Text="[Bennewitz.Ninja.AutoVersioning] Assembly info generator is installed but not enabled. Add the following to your .csproj, Directory.Build.props, or any .props file imported by your build:%0A  &lt;PropertyGroup&gt;%0A    &lt;GenerateAutoVersionedAssemblyInfo&gt;true&lt;/GenerateAutoVersionedAssemblyInfo&gt;%0A    &lt;AssemblyCompany&gt;YourCompany&lt;/AssemblyCompany&gt;%0A    &lt;AssemblyProduct&gt;YourProduct&lt;/AssemblyProduct&gt;%0A    &lt;CopyrightHolder&gt;YourName&lt;/CopyrightHolder&gt; &lt;!-- optional --&gt;%0A    &lt;PublicVersion Condition=&quot;'$$(PublicVersion)' == ''&quot;&gt;$$(YOUR_CI_VERSION_VAR)&lt;/PublicVersion&gt; &lt;!-- optional --&gt;%0A    &lt;CommitSha Condition=&quot;'$$(CommitSha)' == ''&quot;&gt;$$(GITHUB_SHA)&lt;/CommitSha&gt; &lt;!-- optional --&gt;%0A    &lt;IsContinuousIntegration&gt;$$(GITHUB_ACTIONS)&lt;/IsContinuousIntegration&gt; &lt;!-- optional --&gt;%0A  &lt;/PropertyGroup&gt;" />
  </Target>
</Project>
