<#
    Optional local-build wrapper for CONSUMERS of this package (not to be confused with this
    repo's own Pack.ps1, which builds/packs the generator itself). Use Build.sh.template
    instead if you don't have PowerShell 7+ installed (e.g. most Linux/macOS machines).

    Computes build metadata once, in this outer process, and passes it to `dotnet build` as
    global properties (-p:) — the same override mechanism CI is expected to use (see the
    Configuration Reference table in README.md). This gives an EXACT guarantee across every
    project in the build, rather than relying on MSBuild property-evaluation timing.

    What this solves, for local terminal-driven builds only:
      - BuildTimestamp: fixed once, instead of captured independently per project at evaluation
                        time (see docs/MultiProjectBuildTimestamps.md for why that distinction
                        matters on deep dependency chains).
      - CommitSha:      populated from git, mirroring what CI providers already supply via
                        GITHUB_SHA / CI_COMMIT_SHA / BITBUCKET_COMMIT.
      - PublicVersion:  populated from the nearest git tag, mirroring what a tag-triggered
                        release pipeline would supply.

    What this does NOT solve:
      - IDE-triggered builds (Rider "Build Solution", Visual Studio Build) bypass this script
        entirely — they never invoke it, so those builds still fall back to evaluation-time
        BuildTimestamp capture with no CommitSha/PublicVersion. See
        docs/MultiProjectBuildTimestamps.md for the full list of alternatives considered and
        why none of them close that gap without added complexity.

    To use: copy this file to your solution root (alongside Directory.Build.props) and drop the
    .template extension, e.g. `Build.ps1`. Requires PowerShell 7+ and git on PATH.
#>

param(
    # Anything else you'd normally pass to `dotnet build` — e.g. -c Release, a .sln path.
    [Parameter(ValueFromRemainingArguments = $true)]
    [string[]]$BuildArgs
)

# Captured once, before any project evaluates — every project in the build uses this same
# value for its version's HHmm revision, regardless of how long compilation itself takes.
$buildTimestamp = Get-Date -Format 'yyyyMMddHHmmss'

# Full SHA, matching the format CI providers supply (e.g. $(GITHUB_SHA)). Empty if this isn't
# a git repo — the generator already tolerates a missing CommitSha.
$commitSha = git rev-parse HEAD 2>$null

# Nearest tag, matching what a tag-triggered release pipeline would supply. Empty if no tags
# exist yet. Adjust the `git describe` flags if you want the commit-distance suffix instead
# of just the tag name (drop --abbrev=0).
$publicVersion = git describe --tags --abbrev=0 2>$null

# -p: values become global MSBuild properties, which a project's own Condition-guarded
# fallback (e.g. Directory.Build.props.template's CommitSha mapping) can never override —
# a global property can't be reassigned by a plain property element regardless of any
# Condition. So CommitSha/PublicVersion are only passed when git actually produced a value;
# otherwise they're left unset so the project's own fallback logic still runs normally.
$msbuildProperties = @("-p:BuildTimestamp=$buildTimestamp")
if ($commitSha) { $msbuildProperties += "-p:CommitSha=$commitSha" }
if ($publicVersion) { $msbuildProperties += "-p:PublicVersion=$publicVersion" }

dotnet build @msbuildProperties @BuildArgs
