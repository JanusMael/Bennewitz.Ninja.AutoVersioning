<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bennewitz.Ninja.AutoVersioning.Abstractions: the CalVer types a CONSUMER can call.

    plans/00002 exists because BuildVersion.TryGetFromFile is correct, tested, and unreachable: the
    AutoVersioning package ships one analyzer assembly to analyzers\dotnet\cs with no lib\, so a
    consumer's compiler loads it and the consumer's compilation never sees it. This project is the
    lib\ that fixes that.

    ⛔ The GENERATOR compiles these same source files into itself — see the <Compile Include> in
    Bennewitz.Ninja.AutoVersioning.csproj. That duplication is deliberate: the analyzer must stay a
    single self-contained assembly with NO dependencies, because code on the generator's path may
    use only what the compiler host supplies. The generator must never take a PackageReference or
    ProjectReference on this project for these types.

    ⛔ Nor may the TEST project reference this one. It references the generator, and BuildVersion
    exists in both assemblies, so a second reference makes every BuildVersion call site CS0433.
    plans/00002 decision 10.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Unlike the generator, this assembly's name matches its package id and it ships a lib\. -->
    <AssemblyName>Bennewitz.Ninja.AutoVersioning.Abstractions</AssemblyName>
    <RootNamespace>Bennewitz.Ninja.AutoVersioning</RootNamespace>

    <!--
      Packaging. ⛔ IsPackable, the id in packages.push and this metadata were added in ONE change
      (plans/00002 step 3): scripts/assert-packages.cs fails the build on a packed id declared in
      neither packages.push nor packages.local, so flipping one without the other breaks the build.

      Unlike the generator this project packs the SDK's way, with no NuspecFile. The generator needs
      one because its layout is unusual — a single DLL into analyzers\dotnet\cs and no lib\. This is
      an ordinary library, so the default lib\netstandard2.0 placement is exactly right, and a
      hand-written file list is one more thing to get wrong.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>Bennewitz.Ninja.AutoVersioning.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Authors>Brian Bennewitz</Authors>
    <Description>Read a Bennewitz.Ninja.AutoVersioning CalVer stamp back off a built assembly: BuildVersion.TryGetFromFile.</Description>
    <Copyright>Copyright © 2026 Brian Bennewitz</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>assembly-info versioning calver csharp dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/JanusMael/Bennewitz.Ninja.AutoVersioning</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JanusMael/Bennewitz.Ninja.AutoVersioning.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!--
      ⛔ Its own README, plans/00002 decision 12 — NOT the repository's, which opens with analyzer
      setup a consumer of this library never uses. ⚠ A package carrying no README at all passes
      scripts/assert-packages.cs silently: its absolute-link check is guarded by
      `r.Readme is not null`. PackagingTests asserts this one is really in the .nupkg.
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- developmentDependency is deliberately NOT set: unlike the analyzer, this is a library a
         consumer compiles against, so it must flow as an ordinary reference. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
