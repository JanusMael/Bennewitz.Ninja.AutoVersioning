<Project>
  <!-- The family's standard build properties (docs/repository-conventions.md in
       Bennewitz.Ninja.Templates), for this repository's own projects.

       ⚠ Not to be confused with Directory.Build.props.template beside it, which is sample content
       for a CONSUMER of this package, and is not imported by anything here.

       ⓘ This repository does not apply AutoVersioning to itself: a package cannot generate its own
       build. .github/repository.json exempts that one rule, with the reason. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyCompany>Bennewitz.Ninja</AssemblyCompany>
  </PropertyGroup>

  <!-- PDB policy: portable in Debug for local source stepping; embedded in Release so the
       shipped binary carries its own symbols and nothing loose has to travel with it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Microsoft.VisualStudio.Threading.Analyzers, for two rules alone, the maintainer's decision of
       2026-11-03: VSTHRD101, an async lambda given where a void delegate is expected, which makes it
       async void, and VSTHRD110, a task nobody awaits. The first ends the process on a throw and the
       second loses the failure, as Inspections' docs/exception-resilience.md measured. The other
       rules are about Visual Studio's JoinableTaskFactory, or style, and are off: measured on
       DiffView, they found 49 sites and no defect. Private: nothing a package ships carries it. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);VSTHRD001;VSTHRD002;VSTHRD003;VSTHRD004;VSTHRD010;VSTHRD011;VSTHRD012;VSTHRD013</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD100;VSTHRD102;VSTHRD103;VSTHRD104;VSTHRD105;VSTHRD106;VSTHRD107;VSTHRD108;VSTHRD109</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD111;VSTHRD112;VSTHRD113;VSTHRD114;VSTHRD115;VSTHRD116;VSTHRD117</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD200;VSTHRD201;VSTHRD202</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
