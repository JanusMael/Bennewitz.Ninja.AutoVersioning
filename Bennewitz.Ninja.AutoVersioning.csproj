<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Source Generators compatibility requires targeting .NET Standard 2.0 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>

    <AssemblyName>Bennewitz.Ninja.AutoVersioning.SourceGenerators</AssemblyName>
    <RootNamespace>Bennewitz.Ninja.AutoVersioning</RootNamespace>

    <!-- This project lives at the repository root, so its default **/*.cs glob would otherwise
         compile the test project's sources into this netstandard2.0 assembly, and the file-based
         apps under scripts/ too, which fail it with CS9314 on their `#!` line. The friend-grant
         files at the root are linked in by Directory.Build.targets; globbed as well, each would be
         compiled twice.

         ⛔ Abstractions\** is excluded as a directory and its SOURCES ARE LINKED BACK IN below. The
         glob must not take that project's obj\ with it: a nested project's intermediate output is
         not excluded automatically, and its generated assembly-attribute file would be compiled
         here as well, failing with CS0579 duplicate attributes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;scripts\**;Abstractions\**;AssemblyInfo.InternalsVisibleTo*.cs</DefaultItemExcludes>

    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS1032: diagnostic messageFormat intentionally uses \n for readable multi-line build output -->
    <NoWarn>RS1032</NoWarn>

    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
    <SonarQubeExclude>true</SonarQubeExclude>

    <!-- Packaging — update Version before running dotnet pack -->
    <Version>1.0.0</Version>
    <Authors>Brian Bennewitz</Authors>
    <Description>Assembly info incremental source generator.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Keep the generator DLL out of lib/; the nuspec places it in analyzers/dotnet/cs/ only -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Strip all transitive package dependencies from the .nupkg -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NuspecFile>Package.nuspec</NuspecFile>
    <NuspecProperties>configuration=$(Configuration);version=$(Version);assemblyName=$(AssemblyName)</NuspecProperties>
  </PropertyGroup>

  <!--
    The CalVer types, compiled into this analyzer from the .Abstractions project that also ships
    them as a lib\. plans/00002 step 2.

    ⛔ A ProjectReference here would be wrong twice over: the analyzer must remain ONE
    self-contained assembly with no dependencies, because code on the generator's path may use only
    what the compiler host supplies; and referencing an assembly that also declares these types,
    while compiling them from source, is CS0436. Linking the sources is the whole point.

    ReferenceOutputAssembly="false" on the ProjectReference below carries no assembly at all: it
    exists so that `dotnet build` at this root also builds .Abstractions, which otherwise no CI
    step would ever compile — there is no solution file here.
  -->
  <ItemGroup>
    <Compile Include="Abstractions\Versioning\**\*.cs" />
    <ProjectReference Include="Abstractions\Bennewitz.Ninja.AutoVersioning.Abstractions.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <!-- Activates Microsoft.CodeAnalysis.BannedApiAnalyzers (RS0030) against BannedSymbols.txt.
         Without this entry the analyzer is referenced but inert. -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.HashCode" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- required for incremental generators -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>
</Project>
